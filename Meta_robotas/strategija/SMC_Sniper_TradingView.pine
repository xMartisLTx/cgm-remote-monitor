//@version=6
indicator("SMC Sniper v2.0", overlay = true, max_bars_back = 500)

// ─── PARAMETRAI ───────────────────────────────────────────────
emaFastLen = input.int(50,  "EMA 50",  group = "Indikatoriai")
emaSlowLen = input.int(200, "EMA 200", group = "Indikatoriai")
rsiLen     = input.int(14,  "RSI",     group = "Indikatoriai")
atrLen     = input.int(14,  "ATR",     group = "Indikatoriai")
adxLen     = input.int(14,  "ADX",     group = "Indikatoriai")
minScore   = input.int(3,   "Min. balai (iš 5)", minval = 1, maxval = 5, group = "Signalai")
bosWindow  = input.int(15,  "BOS langas",         group = "Signalai")
rrTp1      = input.float(2.0, "TP1 RR", group = "SL/TP")
rrTp2      = input.float(3.0, "TP2 RR", group = "SL/TP")

// ─── INDIKATORIAI ─────────────────────────────────────────────
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi     = ta.rsi(close, rsiLen)
atr     = ta.atr(atrLen)
adx     = ta.rma(math.abs(ta.change(ta.rma(high - low, adxLen))), adxLen)

// ─── EMA LINIJOS ──────────────────────────────────────────────
plot(emaFast, "EMA 50",  color = color.new(color.yellow, 0), linewidth = 2)
plot(emaSlow, "EMA 200", color = color.new(color.white,  0), linewidth = 2)

// ─── TENDENCIJA ───────────────────────────────────────────────
bullTrend = emaFast > emaSlow
bearTrend = emaFast < emaSlow

// ─── BOS ──────────────────────────────────────────────────────
prevHigh = ta.highest(high, bosWindow)[1]
prevLow  = ta.lowest(low,   bosWindow)[1]
bosBull  = high > prevHigh
bosBear  = low  < prevLow

plotshape(bosBull, "BOS ↑", shape.triangleup,
     location.belowbar, color.new(color.aqua, 30), size = size.tiny, text = "BOS")
plotshape(bosBear, "BOS ↓", shape.triangledown,
     location.abovebar, color.new(color.orange, 30), size = size.tiny, text = "BOS")

// ─── CRT ──────────────────────────────────────────────────────
prevMid  = (high[1] + low[1]) / 2.0
crtBull  = low  < low[1]  and close > prevMid
crtBear  = high > high[1] and close < prevMid

plotshape(crtBull, "CRT ↑", shape.circle,
     location.belowbar, color.new(color.lime, 20), size = size.tiny, text = "CRT")
plotshape(crtBear, "CRT ↓", shape.circle,
     location.abovebar, color.new(color.red,  20), size = size.tiny, text = "CRT")

// ─── ORDER BLOCK ──────────────────────────────────────────────
var float obBullHigh = na
var float obBullLow  = na
var float obBearHigh = na
var float obBearLow  = na

if close[1] < open[1] and close > high[1]
    obBullHigh := high[1]
    obBullLow  := low[1]

if close[1] > open[1] and close < low[1]
    obBearHigh := high[1]
    obBearLow  := low[1]

inBullOB = not na(obBullHigh) and close >= obBullLow  and close <= obBullHigh
inBearOB = not na(obBearHigh) and close <= obBearHigh and close >= obBearLow

bgcolor(inBullOB ? color.new(color.green, 88) : na)
bgcolor(inBearOB ? color.new(color.red,   88) : na)

// ─── BALŲ SISTEMA ─────────────────────────────────────────────
// BOS arba CRT privalomas
hasTriggerBull = bosBull or crtBull
hasTriggerBear = bosBear or crtBear

bullScore = 0
bullScore += bullTrend        ? 1 : 0
bullScore += rsi < 55         ? 1 : 0
bullScore += hasTriggerBull   ? 1 : 0
bullScore += inBullOB         ? 1 : 0
bullScore += close > emaSlow  ? 1 : 0

bearScore = 0
bearScore += bearTrend        ? 1 : 0
bearScore += rsi > 45         ? 1 : 0
bearScore += hasTriggerBear   ? 1 : 0
bearScore += inBearOB         ? 1 : 0
bearScore += close < emaSlow  ? 1 : 0

// ─── SIGNALAI — cooldown 10 barų tarp signalų ────────────────
var int lastSignalBar = 0
cooldown = 10

buyRaw  = bullTrend and hasTriggerBull and bullScore >= minScore
sellRaw = bearTrend and hasTriggerBear and bearScore >= minScore

newBuy  = buyRaw  and not buyRaw[1]  and (bar_index - lastSignalBar) >= cooldown
newSell = sellRaw and not sellRaw[1] and (bar_index - lastSignalBar) >= cooldown

if newBuy or newSell
    lastSignalBar := bar_index

buySignal  = newBuy
sellSignal = newSell

plotshape(buySignal,  "BUY",  shape.labelup,
     location.belowbar, color.new(color.green, 0),
     size = size.large, text = "BUY",  textcolor = color.white)
plotshape(sellSignal, "SELL", shape.labeldown,
     location.abovebar, color.new(color.red, 0),
     size = size.large, text = "SELL", textcolor = color.white)

// ─── SL / TP ──────────────────────────────────────────────────
slDist = atr * 1.5

if buySignal
    line.new(bar_index, close - slDist,        bar_index + 20, close - slDist,
         color = color.red,   width = 2, style = line.style_dashed)
    line.new(bar_index, close + slDist * rrTp1, bar_index + 20, close + slDist * rrTp1,
         color = color.lime,  width = 2, style = line.style_dashed)
    line.new(bar_index, close + slDist * rrTp2, bar_index + 20, close + slDist * rrTp2,
         color = color.green, width = 1, style = line.style_dotted)

if sellSignal
    line.new(bar_index, close + slDist,        bar_index + 20, close + slDist,
         color = color.red,   width = 2, style = line.style_dashed)
    line.new(bar_index, close - slDist * rrTp1, bar_index + 20, close - slDist * rrTp1,
         color = color.lime,  width = 2, style = line.style_dashed)
    line.new(bar_index, close - slDist * rrTp2, bar_index + 20, close - slDist * rrTp2,
         color = color.green, width = 1, style = line.style_dotted)

// ─── INFO LENTELĖ ─────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 7,
     bgcolor = color.new(color.black, 15), border_width = 1)

if barstate.islast
    currentScore = bullTrend ? bullScore : bearScore
    sigText  = buySignal ? "BUY ✅" : sellSignal ? "SELL ✅" : "LAUKTI ⏳"
    sigColor = buySignal ? color.lime  : sellSignal ? color.red  : color.orange

    table.cell(t, 0, 0, "SMC SNIPER",   text_color = color.yellow, text_size = size.normal)
    table.cell(t, 1, 0, "v2.0",         text_color = color.yellow, text_size = size.normal)
    table.cell(t, 0, 1, "Tendencija",   text_color = color.white,  text_size = size.small)
    table.cell(t, 1, 1, bullTrend ? "BULL ↑" : "BEAR ↓",
         text_color = bullTrend ? color.lime : color.red, text_size = size.small)
    table.cell(t, 0, 2, "RSI",          text_color = color.white,  text_size = size.small)
    table.cell(t, 1, 2, str.tostring(math.round(rsi, 1)),
         text_color = rsi < 40 ? color.lime : rsi > 60 ? color.red : color.gray,
         text_size = size.small)
    table.cell(t, 0, 3, "BOS",          text_color = color.white,  text_size = size.small)
    table.cell(t, 1, 3, bosBull ? "↑ ✓" : bosBear ? "↓ ✓" : "—",
         text_color = bosBull ? color.lime : bosBear ? color.red : color.gray,
         text_size = size.small)
    table.cell(t, 0, 4, "CRT",          text_color = color.white,  text_size = size.small)
    table.cell(t, 1, 4, crtBull ? "↑ ✓" : crtBear ? "↓ ✓" : "—",
         text_color = crtBull ? color.lime : crtBear ? color.red : color.gray,
         text_size = size.small)
    table.cell(t, 0, 5, "BALAI",        text_color = color.white,  text_size = size.small)
    table.cell(t, 1, 5, str.tostring(currentScore) + "/5",
         text_color = color.yellow, text_size = size.small)
    table.cell(t, 0, 6, "SIGNALAS",     text_color = color.white,  text_size = size.normal)
    table.cell(t, 1, 6, sigText,        text_color = sigColor,      text_size = size.normal)

// ─── ALERTAI ──────────────────────────────────────────────────
alertcondition(buySignal,  "BUY Signalas",  "SMC Sniper: BUY {{ticker}} {{interval}}")
alertcondition(sellSignal, "SELL Signalas", "SMC Sniper: SELL {{ticker}} {{interval}}")
